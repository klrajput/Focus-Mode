# SECRETS: never commit a real `.env` — the root `.gitignore` ignores `.env` and `.env.*` and
# keeps only this `.env.example` tracked. Copy this file to `server/.env`, then replace every
# CHANGE_ME_* placeholder locally. `.env` never goes into git, CI logs, a screenshot or a PR.
# Focus Mode — cloud API environment (TECHNICAL_DESIGN §17 · owner A8 / task T-006).

# --- Runtime -------------------------------------------------------------------------
# Port for the Express API and the /agent-link WebSocket (managed hosts inject their own).
PORT=5000
# Runtime mode: development | test | production (`test` uses mongodb-memory-server).
NODE_ENV=development
# MongoDB connection string; dev = local mongod or a MongoDB Atlas URI kept only in server/.env.
# The database name is a local convention (`focus-mode`), not fixed by the blueprint.
MONGO_URI=mongodb://127.0.0.1:27017/focus-mode

# --- Auth (SEC-2) --------------------------------------------------------------------
# HS256 access-token secret, must be >= 32 bytes and unique per environment.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Access-token lifetime as a jsonwebtoken duration string; SEC-2 pins 30 minutes.
JWT_EXPIRES_IN=30m
# Comma-separated dashboard origins: CORS allow-list (SEC-3) and echoed to agents as allowed origins.
# Add the deployed dashboard URL in production, e.g. https://focus-mode.vercel.app
CLIENT_URL=http://localhost:5173

# --- Pairing key + attestation keys (SEC-5, SEC-7) -----------------------------------
# Server-side pepper for the HMAC-SHA256 of 6-digit pairing codes (SEC-5), >= 32 bytes.
# Generate: openssl rand -base64 48
PAIR_PEPPER=CHANGE_ME_generate_with_openssl_rand_base64_48
# PEM private key that signs the 60 s, nonce-bound device attestation JWTs (SEC-7/REC-003).
# Paste as ONE line: replace the PEM line breaks with literal \n inside double quotes
# (dotenv expands them). EdDSA/Ed25519 keypair generation:
#   openssl genpkey -algorithm ED25519 -out attest-private.pem
#   openssl pkey -in attest-private.pem -pubout -out attest-public.pem
# (ECDSA P-256 / ES256 keys are an accepted alternative; the final algorithm is frozen with
#  the /devices/:id/attest endpoint in T-043.)
ATTEST_PRIVATE_KEY="CHANGE_ME_paste_single_line_PEM_private_key_here"
# Matching PEM public key, served to the Focus Agent at GET /agent/attest-key (not secret).
ATTEST_PUBLIC_KEY="CHANGE_ME_paste_single_line_PEM_public_key_here"

# --- Demo seed data (T-013 seed script; PDF §1.4/§19 exam requirement) ---------------
# Seeded ADMIN login for the evaluator: admin@demo.com / Admin@123 — demo values only,
# never reuse on a real deployment (the seed script refuses production without --force).
SEED_ADMIN_EMAIL=admin@demo.com
# Seeded admin password (bcrypt-hashed at seed time; cost 12 per SEC-1).
SEED_ADMIN_PASSWORD=Admin@123
# Seeded demo USER login: kabir@demo.com / Kabir@123 (persona Kabir in docs/UX_SPEC.md).
SEED_USER_EMAIL=kabir@demo.com
# Seeded demo user password (bcrypt-hashed at seed time).
SEED_USER_PASSWORD=Kabir@123

# --- Logging (NFR-016) ---------------------------------------------------------------
# pino level: fatal | error | warn | info | debug | trace (no secrets/PII in logs, NFR-016).
LOG_LEVEL=info

# --- Rate limiting + reverse proxy (SEC-4, NFR-003; W6 hardening) --------------------
# Failed auth requests allowed per 15 min per IP; the next one gets 429 (SEC-4 default 10).
RATE_LIMIT_AUTH_MAX=10
# Global ceiling: requests/min/IP across the whole `/api/v1` router (429 RATE_LIMITED, default 600).
RATE_LIMIT_API_MAX=600
# Dedicated per-user (or per-IP for public) ceilings, requests/min; see server/src/middlewares/rateLimit.ts.
# Public endpoints (agent links, attestation key): default 60/min/IP.
# NOTE: POST /agent/register has its own frozen 5/min/IP contract ceiling (RATE_LIMIT_AGENT_REGISTER_MAX);
# automated suites that launch several real agents raise it, production should leave the default.
RATE_LIMIT_PUBLIC_MAX=60
# GET /insights per user: default 60/min/user.
RATE_LIMIT_INSIGHTS_MAX=60
# GET /notifications per user: default 120/min/user.
RATE_LIMIT_NOTIFICATIONS_MAX=120
# /users/me* (profile, password) per user: default 60/min/user.
RATE_LIMIT_USERS_MAX=60
# /sessions* per user: default 120/min/user.
RATE_LIMIT_SESSIONS_MAX=120
# /admin* per ADMIN user: default 120/min/user.
RATE_LIMIT_ADMIN_MAX=120
# Express `trust proxy` hops: 0 for local/direct connections; 1 behind Render/Railway so
# req.ip (and therefore every rate limit above) sees the real client instead of the proxy.
# (TRUST_PROXY below: 0 = direct connection, 1 behind a single reverse proxy like
# Render/Railway; never `true` or clients could spoof X-Forwarded-For.)
TRUST_PROXY=0
