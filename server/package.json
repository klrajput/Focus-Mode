{
  "name": "@focus-mode/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Focus Mode cloud API — Express 5 + MongoDB (Mongoose): auth, devices, sessions, allow-lists, schedules, insights, admin.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.1",
    "node-cron": "4.6.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
