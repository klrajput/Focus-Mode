{
  "name": "@focus-mode/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared protocol types, zod schemas, error codes and constants for dashboard, API and Focus Agent.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
