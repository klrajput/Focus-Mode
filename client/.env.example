# SECRETS: never commit a real `.env` — the root `.gitignore` ignores `.env` and `.env.*` and
# keeps only this `.env.example` tracked. Copy this file to `client/.env` for local development.
# Vite inlines every `VITE_*` value into the PUBLIC browser bundle, so this file must never
# contain a secret, token or private key.
# Focus Mode — dashboard environment (TECHNICAL_DESIGN §17 · owner A8 / task T-006).

# --- Cloud API -----------------------------------------------------------------------
# Base URL of the API INCLUDING the `/api/v1` prefix (NFR-009); axios uses it as `baseURL`.
# Local dev: the Express server on :5000. Production: use `/api/v1` (same-origin) so the Vercel
# `/api/*` rewrite proxies to the API host — no CORS and no third-party-cookie problems (§5.2).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# --- Focus Agent local channel (§6.1) ------------------------------------------------
# Preferred loopback port of the Focus Agent WebSocket link (ws://127.0.0.1:<port>/link).
VITE_AGENT_PORT=4545
# Number of consecutive ports to scan when the preferred port is busy: 4545, 4546, 4547,
# 4548, 4549 — i.e. the range 4545–4549 (a count of 5, per TECHNICAL_DESIGN §6.1).
VITE_AGENT_PORT_RANGE=5
