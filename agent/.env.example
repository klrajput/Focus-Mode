# SECRETS: never commit a real `.env` — the root `.gitignore` ignores `.env` and `.env.*` and
# keeps only this `.env.example` tracked. Copy this file to `agent/.env` for local development;
# a packaged Focus Agent installer must never include a `.env` file.
# Focus Mode — Focus Agent environment (TECHNICAL_DESIGN §17 · owner A8 / task T-006).

# --- Local link (§6.1) ---------------------------------------------------------------
# Loopback port for the dashboard↔agent WebSocket (PDF default 4545; falls back to 4546–4549).
# The agent always binds 127.0.0.1 only — never 0.0.0.0 / the LAN (NFR-010).
AGENT_PORT=4545
# Cloud API base URL INCLUDING the `/api/v1` prefix: agent register, enroll poll and the outbound
# /agent-link WebSocket use it. Production must be HTTPS (wss://…/agent-link).
AGENT_API_BASE_URL=http://localhost:5000/api/v1
# Comma-separated browser Origins allowed to open the local link; no wildcards (NFR-010).
# Same list as the server's CLIENT_URL; add the deployed dashboard origin in production.
AGENT_ALLOWED_ORIGINS=http://localhost:5173

# --- Focus driver + runtime ----------------------------------------------------------
# real | fake. `real` uses the OS driver (koffi on Windows, osascript on macOS, X11 tools on Linux).
# `fake` is the in-memory dev/test driver: unit/E2E tests ONLY — it must NEVER be the default in
# a packaged build (TECHNICAL_DESIGN §7.5), so the shipped default here is `real`.
AGENT_FOCUS_DRIVER=real
# electron-log level: error | warn | info | verbose | debug | silly (NFR-016; no window titles/PII).
AGENT_LOG_LEVEL=info
# 1 = headless (no tray/window; Playwright E2E only) · 0 = visible agent (always 0 for humans).
AGENT_HEADLESS=0
